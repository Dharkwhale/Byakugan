# One RPC_URL_<chainId> per chain you want to index.
RPC_URL_1=
RPC_URL_8453=
RPC_URL_42161=

# Used when --chain is omitted.
DEFAULT_CHAIN_ID=1

# Optional. Enables the Etherscan V2 deploy-block fallback (one key, all chains).
ETHERSCAN_API_KEY=

DB_PATH=./data/byakugan.db

# The Telegram bot (npm run bot). Both are required to run it; see the README.
# Token: from @BotFather. Allowed ids: comma-separated NUMERIC Telegram user ids.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
